<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.theme_color | default: '#14213D' }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- if settings.klaviyo_public_key != blank -%}
      <script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id={{ settings.klaviyo_public_key | escape }}"></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}

    <div class="pw-owner">
      <details class="pw-owner__details">
        <summary class="pw-owner__summary">Accesso staff</summary>
        <div class="pw-owner__panel">
          {%- form 'storefront_password' -%}
            <label for="pw-input" class="pw-owner__label">Password negozio</label>
            <div class="pw-owner__row">
              <input
                type="password"
                name="password"
                id="pw-input"
                class="pw-owner__input"
                autocomplete="current-password"
                placeholder="Password"
                {% if form.errors %}autofocus aria-invalid="true"{% endif %}
              >
              <button type="submit" class="pw-owner__btn">Entra</button>
            </div>
            {%- if form.errors -%}
              <p class="pw-owner__err">Password errata, riprova.</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </details>
    </div>

    <style>
      .pw-owner {
        position: fixed;
        bottom: 14px;
        right: 16px;
        z-index: 9999;
        font-family: system-ui, -apple-system, sans-serif;
      }
      .pw-owner__summary {
        list-style: none;
        cursor: pointer;
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(244, 239, 230, 0.45);
        padding: 6px 8px;
        text-align: right;
        user-select: none;
      }
      .pw-owner__summary::-webkit-details-marker { display: none; }
      .pw-owner__summary:hover { color: rgba(244, 239, 230, 0.8); }
      .pw-owner__panel {
        margin-top: 8px;
        padding: 14px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(244, 239, 230, 0.18);
        border-radius: 3px;
        backdrop-filter: blur(6px);
      }
      .pw-owner__label {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(244, 239, 230, 0.55);
        margin-bottom: 6px;
      }
      .pw-owner__row { display: flex; gap: 6px; }
      .pw-owner__input {
        background: transparent;
        border: 1px solid rgba(244, 239, 230, 0.3);
        border-radius: 2px;
        color: #f4efe6;
        padding: 8px 10px;
        font-size: 0.85rem;
        outline: none;
      }
      .pw-owner__input:focus { border-color: #d4a24c; }
      .pw-owner__btn {
        background: #d4a24c;
        border: 0;
        border-radius: 2px;
        color: #14213d;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0 14px;
        cursor: pointer;
      }
      .pw-owner__err {
        margin: 8px 0 0;
        font-size: 0.72rem;
        color: #e9a6a6;
      }
    </style>
  </body>
</html>
